# --- Base de datos -----------------------------------------------------------
# Neon (plan gratuito): Dashboard > Connection string > Pooled connection.
# Se elige Neon y no Supabase porque el plan gratuito de Supabase PAUSA el
# proyecto tras 7 dias sin actividad y hay que despausarlo a mano; Neon se
# duerme igual pero se despierta solo en medio segundo.
#
# Si se deja vacia, la app arranca con Postgres embebido en ./.pglite
DATABASE_URL=

# --- Sesiones (OBLIGATORIO en produccion) ------------------------------------
# Firma las cookies de sesion. Sin el, la app no arranca.
# Generalo con:  openssl rand -base64 48
SESSION_SECRET=

# --- Modo desarrollo ---------------------------------------------------------
# Con true, /login anade un selector de usuario sin contrasena.
# Se apaga solo cuando NODE_ENV=production, aunque quede en true.
DEV_AUTH=true

# --- Endpoint público de leads ----------------------------------------------
# La landing debe enviar este token en la cabecera x-crm-token.
PUBLIC_FORM_TOKEN=cambia-esto

# --- Cron --------------------------------------------------------------------
# Protege /api/cron. Vercel Cron o Inngest lo envían como Bearer.
CRON_SECRET=cambia-esto

# --- Calendly (semana 3) -----------------------------------------------------
CALENDLY_WEBHOOK_SIGNING_KEY=

# --- IA (semana 4) -----------------------------------------------------------
ANTHROPIC_API_KEY=

# --- Meta (semana 4) ---------------------------------------------------------
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_DATASET_ID=

# --- Hotmart, vía Zapier ------------------------------------------------------
# Zapier lo envía en la cabecera x-crm-token al POST /api/webhooks/hotmart
HOTMART_WEBHOOK_TOKEN=cambia-esto

# --- ManyChat / Instagram DM --------------------------------------------------
# ManyChat lo envía en la cabecera x-crm-token al POST /api/webhooks/manychat
MANYCHAT_WEBHOOK_TOKEN=cambia-esto
